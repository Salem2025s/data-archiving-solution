# Environnement et cache
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets et données locales (jamais dans l'image)
.env
*.env
!.env.example

# Artefacts lourds (les modèles DL de ~2 Go n'entrent pas dans l'image de prod ;
# l'image sert le LinearSVC léger). `**` requis pour matcher les chemins imbriqués.
**/*.onnx.data
**/*.onnx
artifacts/xlmr_v1/
artifacts/xlmr_v3/
artifacts/**/tokenizer.json
exports/
LLM/
*.joblib.zip

# Documentation et certification (hors runtime)
docs/
.github/
.git/
tests/
*.md
