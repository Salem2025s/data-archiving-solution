# Modèle de configuration — copier vers `.env` et renseigner les secrets.
# Les noms de variables correspondent EXACTEMENT aux champs de src/config/settings.py.
# Ne jamais committer le vrai `.env` (il est gitignoré).

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=pfe-data-ia
APP_ENV=dev                       # dev | staging | prod
DEBUG=true

# ── PostgreSQL (entrepôt cible) ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pfe_data_ia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ── Oracle PeopleSoft EP92U038 (source, lecture seule via VPN) ──────────────
ORACLE_HOST=192.168.11.111
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=EP92U038
ORACLE_USER=SYSADM
ORACLE_PASSWORD=change_me          # obligatoire (validé non vide par Settings)
ORACLE_OWNER=SYSADM
# Résilience des extractions longues sur VPN (valeurs par défaut) :
ORACLE_EXPIRE_TIME_MINUTES=1       # keepalive détection connexions mortes (0 = off)
ORACLE_TCP_CONNECT_TIMEOUT=20.0    # timeout (s) d'ouverture d'une connexion
ORACLE_QUERY_MAX_ATTEMPTS=4        # nb max de tentatives d'une requête sur coupure

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Pipeline ────────────────────────────────────────────────────────────────
DEFAULT_RUN_TYPE=full              # full | incremental
DEFAULT_SOURCE_SYSTEM=oracle       # source unique : Oracle PeopleSoft EP92U038
RUN_ID=                            # laisser vide → UUID auto-généré
